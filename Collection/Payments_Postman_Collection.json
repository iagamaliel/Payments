  "item": [
    {
      "name": "01 - Successful authentication",
      "item": [
        {
          "name": "AB - Valid channel and API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{abApiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/companies?channel=AB",
            "description": "Expected: 200 OK. AB is active and has ShowMenu=true."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CJ - Valid channel and API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{cjApiKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/companies?channel=CJ",
            "description": "Expected: 200 OK. CJ is active and has ShowMenu=false."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
