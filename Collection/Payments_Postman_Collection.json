  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:44352",
      "type": "string"
    },
    {
      "key": "abApiKey",
      "value": "AB-DEMO-API-KEY",
      "type": "string"
    },
    {
      "key": "cjApiKey",
